#version 460
// Volumetric cloud ray march at reduced resolution.
//
// With upscale factor N, each invocation marches one full-resolution pixel out of an N x N block;
// the pixel inside the block rotates every frame (Bayer order) and reconstruct.comp fills the rest
// from reprojected history. Output: in-scattered radiance (rgb) + transmittance (a), plus a
// transmittance-weighted cloud depth used for reprojection.

#include "clouds.glsl"
#include "atmosphere.glsl"

layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;

const float NO_CLOUD_DEPTH = 1e6;

float interleavedGradientNoise(vec2 p, int frame) {
    p += 5.588238 * float(frame & 63);
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

// Per-pixel jitter in [0,1). Blue noise animated with the golden ratio (R1 sequence).
float jitter(ivec2 pixel, int frame) {
    if (hasFlag(FLAG_BLUE_NOISE)) {
        float bn = texelFetch(blueNoiseTex, pixel & 63, 0).r;
        return fract(bn + float(frame) * 0.61803398875);
    }
    return interleavedGradientNoise(vec2(pixel), frame);
}

float lightOpticalDepth(vec3 p, float lod) {
    int steps = u.march.y;
    vec3 L = u.sunDir.xyz;
    float baseStep = (u.cloudLayer.y - u.cloudLayer.x) * 0.5 / float(steps);
    float od = 0.0, t = 0.0;
    for (int i = 0; i < steps; ++i) {
        float stepLen = baseStep * (1.0 + float(i) * 0.75);  // cone: growing steps
        t += stepLen;
        vec3 s = p + L * (t - 0.5 * stepLen);
        float h = heightFraction(s);
        if (h <= 0.0 || h >= 1.0) break;
        bool cheap = hasFlag(FLAG_CHEAP_LIGHT) && i >= steps / 2;
        od += cloudDensity(s, h, cheap, lod + float(i) * 0.5) * stepLen;
    }
    return od;
}

void main() {
    ivec2 lowSize = imageSize(cloudLowImg);
    ivec2 lowPixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(lowPixel, lowSize))) return;

    int N = u.recon.x;
    ivec2 fullPixel = min(lowPixel * N + u.recon.yz, u.view.yz - 1);

    vec3 ro = u.cameraPos.xyz;
    vec3 rd = rayDirection(vec2(fullPixel) + 0.5);
    float maxDist = min(sceneDistance(fullPixel, rd), 60000.0);
    vec2 seg = cloudSegment(ro, rd, maxDist);
    if (seg.y <= seg.x) {
        imageStore(cloudLowImg, lowPixel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(cloudDepthImg, lowPixel, vec4(NO_CLOUD_DEPTH));
        return;
    }

    int frame = u.march.z;
    int steps = u.march.x;
    float stepLen = (seg.y - seg.x) / float(steps);
    float t = seg.x + stepLen * jitter(fullPixel, frame);

    // Lighting terms that are constant along the ray.
    float cosTheta = dot(rd, u.sunDir.xyz);
    vec3 midCloud = ro + rd * (0.5 * (seg.x + seg.y));
    vec3 sunLight = u.sunDir.w * sunTransmittance(vec3(midCloud.x, u.cloudLayer.x, midCloud.z));
    vec3 skyUp = sampleSky(vec3(0.0, 1.0, 0.0));
    vec3 skyHorizon = sampleSky(normalize(vec3(-u.sunDir.x, 0.15, -u.sunDir.z)));
    vec3 ambient = (skyUp * 0.7 + skyHorizon * 0.3) * u.cloudLight.x;

    float transmittance = 1.0;
    vec3 scattered = vec3(0.0);
    float depthSum = 0.0, depthWeight = 0.0;

    bool adaptive = hasFlag(FLAG_ADAPTIVE_STEP);
    bool searching = adaptive;
    int emptySamples = 0;
    float coarseStep = stepLen * 3.0;

    for (int i = 0; i < steps * 2; ++i) {
        if (t >= seg.y) break;
        vec3 p = ro + rd * t;
        float h = heightFraction(p);
        float lod = hasFlag(FLAG_NOISE_TEXTURES) ? clamp(log2(t / 6000.0), 0.0, 4.0) : 0.0;

        if (searching) {
            // Big steps with the cheap density until we hit something, then back up one step.
            if (cloudDensity(p, h, true, lod) > 0.0) {
                searching = false;
                emptySamples = 0;
                t = max(t - coarseStep, seg.x);
            } else {
                t += coarseStep;
            }
            continue;
        }

        float sigma = cloudDensity(p, h, false, lod);
        if (sigma > 0.0) {
            emptySamples = 0;
            float od = lightOpticalDepth(p, lod);

            // Multiple scattering approximation (Wrenninge 2013): attenuated octaves.
            float sunEnergy = 0.0;
            float a = 1.0, b = 1.0, c = 1.0;
            for (int o = 0; o < 3; ++o) {
                sunEnergy += a * cloudPhase(cosTheta, c) * exp(-od * b);
                a *= 0.5; b *= 0.5; c *= 0.5;
            }
            float powder = mix(1.0, 1.0 - exp(-sigma * 400.0), u.cloudLight.y);

            vec3 S = (sunLight * sunEnergy * powder + ambient * mix(0.2, 1.0, h)) * sigma;
            float stepT = exp(-sigma * stepLen);
            // Energy-conserving integration over the step (Hillaire 2015).
            scattered += transmittance * (S - S * stepT) / sigma;
            depthSum += t * transmittance * (1.0 - stepT);
            depthWeight += transmittance * (1.0 - stepT);
            transmittance *= stepT;

            if (hasFlag(FLAG_EARLY_EXIT) && transmittance < 0.01) break;
        } else if (adaptive && ++emptySamples > 6) {
            searching = true;
        }
        t += stepLen;
    }

    float depth = depthWeight > 1e-4 ? depthSum / depthWeight : NO_CLOUD_DEPTH;

    // Fade distant clouds into the sky behind them (cheap aerial perspective).
    float fade = depthWeight > 1e-4 ? exp(-depth / u.shadowOrigin.z) : 1.0;
    imageStore(cloudLowImg, lowPixel, vec4(scattered * fade, mix(1.0, transmittance, fade)));
    imageStore(cloudDepthImg, lowPixel, vec4(depth));
}
