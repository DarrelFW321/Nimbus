#version 460
// Top-down cloud shadow map around the camera: transmittance from the ground towards the sun.

#include "clouds.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

float groundHeight(vec2 xz) {
    if (u.view.w == 0) return 0.0;
    return textureLod(heightTex, xz / u.terrain.x, 0.0).r * u.terrain.y;
}

void main() {
    ivec2 size = imageSize(cloudShadowImg);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 xz = u.shadowOrigin.xy + (uv - 0.5) * u.terrainOrigin.z;
    vec3 p0 = vec3(xz.x, groundHeight(xz), xz.y);
    vec3 L = u.sunDir.xyz;

    float transmittance = 1.0;
    vec2 seg = cloudSegment(p0, L, 40000.0);
    if (L.y > 0.0 && seg.y > seg.x) {
        const int STEPS = 16;
        float dt = (seg.y - seg.x) / float(STEPS);
        float od = 0.0;
        for (int i = 0; i < STEPS; ++i) {
            vec3 p = p0 + L * (seg.x + (float(i) + 0.5) * dt);
            od += cloudDensity(p, heightFraction(p), true, 1.0) * dt;
        }
        transmittance = exp(-od);
    }
    imageStore(cloudShadowImg, pixel, vec4(transmittance));
}
